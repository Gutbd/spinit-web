# Firebase Web SDK config for the `spinit-ddc64` project's "SpinIt Live Spectator" Web app.
# These are NOT secrets (see README "Security posture") — but real values still aren't committed
# here; copy this file to `.env.local` (already gitignored by Vite's scaffold) and fill them in.
#
# Obtain real values with:
#   firebase apps:sdkconfig WEB <appId> --project spinit-ddc64
# (appId for "SpinIt Live Spectator": 1:706525956576:web:f21ca164a3723f9b410385 — registered
# during FEATURE-007 Implementation Part 4; re-run the command above to fetch current values.)

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
